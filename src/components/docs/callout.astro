---
import type { HTMLAttributes } from "astro/types"

import { cn } from "~/lib/utils"

type Props = HTMLAttributes<"div"> & {
  title?: unknown
  icon?: unknown
  variant?: "default" | "info" | "warning"
}

const { class: className, title, icon, variant = "default", ...props } = Astro.props

const hasIconSlot = Astro.slots.has("icon")
const hasIcon = Boolean(icon) || hasIconSlot

const variantClass = {
  default: "border-border bg-card text-card-foreground",
  info: "border-blue-300 bg-blue-50 text-blue-950 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-100",
  warning:
    "border-amber-300 bg-amber-50 text-amber-950 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-100"
}[variant]
---

<div
  class={cn(
    "mt-6 grid w-auto grid-cols-[0_1fr] items-start gap-y-1 rounded-xl border px-4 py-3 text-sm [&_code]:border",
    variantClass,
    className
  )}
  data-variant={variant}
  {...props}
>
  {
    hasIcon && (
      <div class="col-start-1 row-span-2 mt-0.5 mr-3 text-current [&_svg]:size-4">
        {icon}
        {!icon && <slot name="icon" />}
      </div>
    )
  }

  {
    title && (
      <div
        class={cn("min-h-4 font-medium tracking-tight", hasIcon ? "col-start-2" : "col-start-1")}
      >
        {title}
      </div>
    )
  }

  <div
    class={cn(
      "grid gap-1 text-sm [&_p]:leading-relaxed",
      hasIcon || title ? "col-start-2" : "col-start-1",
      variant === "default" ? "text-muted-foreground" : "text-current/80"
    )}
  >
    <slot />
  </div>
</div>
